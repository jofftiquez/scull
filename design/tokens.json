  "tier": {
    "S0_regenerable": { "fill": "#7C4DFF", "text": "#FFFFFF", "fg": "#6B3FD9", "label": "Regenerable" },
    "S1_costly": { "fill": "#DCCBFF", "text": "#15121A", "fg": "#6B4FB3", "label": "Costly" },
    "S2_uncertain": { "fill": "repeating-linear-gradient(135deg, #FFB547 0 4px, #FFD08A 4px 8px)", "solid": "#FFB547", "stripe": "#FFD08A", "text": "#15121A", "fg": "#9A5C00", "label": "Uncertain" },
