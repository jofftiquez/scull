    "tier": {
      "S0_regenerable": { "fg": "#B9A2FF" },
      "S1_costly": { "fg": "#D2C0FF" },
      "S2_uncertain": { "fg": "#FFB547" },
      "S3_protected": { "fill": "repeating-linear-gradient(135deg, #7F6A9B 0 3px, #5E4A79 3px 6px)", "solid": "#7F6A9B", "stripe": "#5E4A79", "swatch": "#7F6A9B", "fg": "#BCA9D9" }
    }
  },
  "font": {
    "sans": "'DM Sans', system-ui, sans-serif",
    "mono": "'DM Mono', ui-monospace, monospace",
    "googleFonts": "https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Mono:wght@400;500&display=swap",
    "scale": { "caption": 12, "body": 14, "label": 13, "h3": 18, "h2": 20, "h1": 28, "statSm": 26, "statMd": 40, "statLg": 56, "statXl": 64 }
  },
  "radius": { "tileLg": 24, "tile": 22, "card": 16, "button": 12, "buttonLg": 14, "small": 10, "chip": 999 },
  "space": { "pageGap": 12, "pagePadding": 12, "tilePadding": 24, "tilePaddingSm": 20 },
  "elevation": "none — no shadows anywhere; separation comes from ground vs surface color and hairlines",
  "motion": {
    "pop": "scull-pop 340ms ease-out",
    "bounce": "scull-bounce 640ms cubic-bezier(.2,.9,.3,1.3)",
    "rise": "scull-rise 260-420ms ease-out",
    "collapse": "scull-collapse 520ms ease-in forwards",
    "shimmer": "scull-shimmer 600ms linear infinite (progress fills)",
    "burst": "scull-b0..b9 700-1100ms cubic-bezier(.15,.7,.3,1) (particles)",
    "reducedMotion": "all animations collapse to 1ms under prefers-reduced-motion"
  },
  "minTouchTarget": 44
}
