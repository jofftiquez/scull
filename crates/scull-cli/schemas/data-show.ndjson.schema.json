{
  "$defs": {
    "DataShowReport": {
      "additionalProperties": false,
      "description": "`scull data show` output.",
      "properties": {
        "database": {
          "$ref": "#/$defs/DatabaseReport",
          "description": "The database."
        },
        "dirs": {
          "$ref": "#/$defs/DirsReport",
          "description": "scull's directories."
        },
        "files": {
          "description": "scull's own files.",
          "items": {
            "$ref": "#/$defs/OwnFile"
          },
          "type": "array"
        },
        "footprint_bytes": {
          "description": "Their total size in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "quarantine": {
          "$ref": "#/$defs/QuarantineReport",
          "description": "Quarantine, as recorded."
        },
        "tables": {
          "description": "Rows per table (empty when the database can't be read).",
          "items": {
            "$ref": "#/$defs/TableRows"
          },
          "type": "array"
        }
      },
      "required": [
        "dirs",
        "database",
        "tables",
        "files",
        "footprint_bytes",
        "quarantine"
      ],
      "type": "object"
    },
    "DatabaseReport": {
      "additionalProperties": false,
      "description": "The database.",
      "properties": {
        "detail": {
          "description": "Why it couldn't be read, when it couldn't.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "$ref": "#/$defs/FsPath",
          "description": "Database file."
        },
        "schema_version": {
          "description": "Its schema version, when known.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/DbState",
          "description": "How it looks."
        },
        "supported_schema_version": {
          "description": "The schema version this scull uses.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "state",
        "supported_schema_version"
      ],
      "type": "object"
    },
    "DbState": {
      "description": "How the database looks to this command.",
      "oneOf": [
        {
          "const": "ok",
          "description": "Opened with the current schema.",
          "type": "string"
        },
        {
          "const": "missing",
          "description": "No database file.",
          "type": "string"
        },
        {
          "const": "empty",
          "description": "An empty database (never used).",
          "type": "string"
        },
        {
          "const": "newer_schema",
          "description": "Written by a newer scull.",
          "type": "string"
        },
        {
          "const": "needs_migration",
          "description": "Older schema; the next command that writes to it migrates it.",
          "type": "string"
        },
        {
          "const": "not_scull",
          "description": "Something other than a scull database, or not a regular file.",
          "type": "string"
        },
        {
          "const": "unreadable",
          "description": "Damaged or unreadable.",
          "type": "string"
        }
      ]
    },
    "DirsReport": {
      "additionalProperties": false,
      "description": "scull's per-user directories.",
      "properties": {
        "cache": {
          "$ref": "#/$defs/FsPath",
          "description": "Disposable cache."
        },
        "config": {
          "$ref": "#/$defs/FsPath",
          "description": "Configuration (`config.toml`, profile). Never purged."
        },
        "data": {
          "$ref": "#/$defs/FsPath",
          "description": "Database, backups, audit mirrors, salt."
        },
        "state": {
          "$ref": "#/$defs/FsPath",
          "description": "Logs and other state."
        }
      },
      "required": [
        "config",
        "data",
        "cache",
        "state"
      ],
      "type": "object"
    },
    "FileKind": {
      "description": "What a file of scull's own footprint is.",
      "oneOf": [
        {
          "const": "database",
          "description": "The database.",
          "type": "string"
        },
        {
          "const": "wal",
          "description": "Its write-ahead log.",
          "type": "string"
        },
        {
          "const": "shm",
          "description": "Its shared-memory index.",
          "type": "string"
        },
        {
          "const": "journal",
          "description": "A rollback journal.",
          "type": "string"
        },
        {
          "const": "backup",
          "description": "A backup taken before a migration.",
          "type": "string"
        },
        {
          "const": "damaged",
          "description": "A damaged database set aside by a restore.",
          "type": "string"
        },
        {
          "const": "side_file",
          "description": "A `-wal`, `-shm` or `-journal` file of a backup or damaged copy.",
          "type": "string"
        },
        {
          "const": "audit_mirror",
          "description": "A file in the audit mirror folder (`<operation-id>.ndjson`).",
          "type": "string"
        },
        {
          "const": "salt",
          "description": "The MCP name-hashing salt (never printed).",
          "type": "string"
        },
        {
          "const": "other",
          "description": "Another file the storage layer reports as part of the footprint.",
          "type": "string"
        }
      ]
    },
    "FsPath": {
      "description": "A filesystem path as it appears in plans, JSON output and the database.\n\nSerialized as a string. Paths that aren't valid Unicode (possible on Unix and Windows) are\nconverted lossily with U+FFFD and flagged by [`FsPath::is_lossy`]; the engine never acts on\na path read back from JSON alone. Items are matched by [`crate::ItemId`] and file identity,\nand candidates are re-derived from the disk before execution (SAFE-05, SAFE-11).",
      "type": "string"
    },
    "OwnFile": {
      "additionalProperties": false,
      "description": "One file of scull's own footprint.",
      "properties": {
        "bytes": {
          "description": "Logical size in bytes (of the link itself for a symlink).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "entry": {
          "description": "Entry type, not following links (`file`, `symlink`, ...).",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FileKind",
          "description": "What it is."
        },
        "modified_at": {
          "description": "Last modification (Unix seconds), if known.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "$ref": "#/$defs/FsPath",
          "description": "Where it is."
        }
      },
      "required": [
        "path",
        "kind",
        "entry",
        "bytes"
      ],
      "type": "object"
    },
    "QuarantineBase": {
      "additionalProperties": false,
      "description": "One `quarantine.bases` entry.",
      "properties": {
        "base": {
          "$ref": "#/$defs/FsPath",
          "description": "The base used for items under it."
        },
        "prefix": {
          "$ref": "#/$defs/FsPath",
          "description": "Volume mount point or directory."
        }
      },
      "required": [
        "prefix",
        "base"
      ],
      "type": "object"
    },
    "QuarantineLocation": {
      "additionalProperties": false,
      "description": "Where new quarantines go: `<base>/.scull-quarantine/` on each item's volume.",
      "properties": {
        "base": {
          "anyOf": [
            {
              "$ref": "#/$defs/FsPath"
            },
            {
              "type": "null"
            }
          ],
          "description": "`quarantine.base`: for items on the volume holding it."
        },
        "bases": {
          "description": "`quarantine.bases`: items under `prefix` use `base` (longest prefix wins).",
          "items": {
            "$ref": "#/$defs/QuarantineBase"
          },
          "type": "array"
        },
        "configured": {
          "description": "Whether a base is configured; `false`: automatic (the shallowest folder above the item,\non its volume, that you own).",
          "type": "boolean"
        },
        "error": {
          "description": "Why the configuration couldn't be read, if it couldn't (the location is then unknown).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "configured",
        "bases"
      ],
      "type": "object"
    },
    "QuarantineReport": {
      "additionalProperties": false,
      "description": "Quarantine as recorded in the manifest (the manifest of record, SAFE-16).",
      "properties": {
        "folders": {
          "description": "Folders holding them, as recorded (parents of the quarantine paths), sorted.",
          "items": {
            "$ref": "#/$defs/FsPath"
          },
          "type": "array"
        },
        "known": {
          "description": "Whether the manifest could be read (false when the database couldn't).",
          "type": "boolean"
        },
        "location": {
          "$ref": "#/$defs/QuarantineLocation",
          "description": "Where new quarantines go (`[quarantine]` in the config, `SCULL_QUARANTINE_BASE`;\nP2-EXEC-13)."
        },
        "outstanding_bytes": {
          "description": "Their recorded size in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "outstanding_items": {
          "description": "Items quarantined and neither restored nor purged.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "known",
        "outstanding_items",
        "outstanding_bytes",
        "folders",
        "location"
      ],
      "type": "object"
    },
    "TableRows": {
      "additionalProperties": false,
      "description": "Rows in one table.",
      "properties": {
        "rows": {
          "description": "Rows.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "table": {
          "description": "Table name.",
          "type": "string"
        }
      },
      "required": [
        "table",
        "rows"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One line of `--ndjson` output with schema scull/data-show@1: `type` selects the shape of `data`.",
  "properties": {
    "data": {
      "$ref": "#/$defs/DataShowReport",
      "description": "The payload, as in the command's `--json` document."
    },
    "schema": {
      "const": "scull/data-show@1",
      "description": "`scull/<name>@<major>`.",
      "pattern": "^scull/[a-z][a-z0-9-]*@[1-9][0-9]*$",
      "type": "string"
    },
    "type": {
      "const": "data",
      "description": "The record type (one value per command, e.g. `status`).",
      "type": "string"
    },
    "version": {
      "description": "The scull version that wrote it.",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "version",
    "type",
    "data"
  ],
  "title": "scull/data-show@1 (NDJSON line)",
  "type": "object"
}
