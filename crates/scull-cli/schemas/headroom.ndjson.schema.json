{
  "$defs": {
    "FileIdentity": {
      "additionalProperties": false,
      "description": "Path-independent identity of a filesystem object (device/volume + inode/file ID).",
      "properties": {
        "file": {
          "description": "Inode / file ID as lowercase hex.",
          "pattern": "^[0-9a-f]{1,32}$",
          "type": "string"
        },
        "volume": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "volume",
        "file"
      ],
      "type": "object"
    },
    "HeadroomManifest": {
      "additionalProperties": false,
      "description": "What scull recorded when it created the reserve.",
      "properties": {
        "allocated_bytes": {
          "description": "Its allocated size when created (bytes): the space it really holds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "created_at": {
          "description": "When it was created (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "identity": {
          "$ref": "#/$defs/FileIdentity",
          "description": "Its no-follow identity when created."
        },
        "relative": {
          "description": "The reserve, relative to the data directory (always [`reserve_relative`]).",
          "type": "string"
        },
        "size_bytes": {
          "description": "Its logical size (bytes).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "description": "Format version ([`MANIFEST_VERSION`]).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "volume_id": {
          "description": "The volume it is on (mount point).",
          "type": "string"
        }
      },
      "required": [
        "version",
        "relative",
        "identity",
        "size_bytes",
        "allocated_bytes",
        "volume_id",
        "created_at"
      ],
      "type": "object"
    },
    "HeadroomReport": {
      "additionalProperties": false,
      "description": "What `scull headroom` did.",
      "properties": {
        "action": {
          "description": "`status`, `create` or `release`.",
          "type": "string"
        },
        "audit_error": {
          "description": "Why the outcome could not be recorded in the history database, when it couldn't.",
          "type": [
            "string",
            "null"
          ]
        },
        "created": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeadroomManifest"
            },
            {
              "type": "null"
            }
          ],
          "description": "The reserve that was created (`create`)."
        },
        "released": {
          "anyOf": [
            {
              "$ref": "#/$defs/Released"
            },
            {
              "type": "null"
            }
          ],
          "description": "What was released (`release`)."
        },
        "status": {
          "$ref": "#/$defs/HeadroomStatus",
          "description": "The reserve's status after the command."
        }
      },
      "required": [
        "action",
        "status"
      ],
      "type": "object"
    },
    "HeadroomState": {
      "description": "What the reserve looks like now.",
      "oneOf": [
        {
          "const": "none",
          "description": "No reserve (the default).",
          "type": "string"
        },
        {
          "const": "ready",
          "description": "The reserve exists and matches its manifest: it can be released.",
          "type": "string"
        },
        {
          "const": "missing",
          "description": "The manifest is there but the file is gone (released outside scull, or a release\nwhose record is missing). Releasing only removes the manifest.",
          "type": "string"
        },
        {
          "const": "changed",
          "description": "Something at the path differs from the manifest (identity, kind or size): scull will\nnot release it.",
          "type": "string"
        },
        {
          "const": "unreadable",
          "description": "The manifest can't be read: scull will not release anything.",
          "type": "string"
        },
        {
          "const": "unrecorded",
          "description": "A file is at the reserve's path but there is no manifest: scull didn't record it and\nwill not release it.",
          "type": "string"
        }
      ]
    },
    "HeadroomStatus": {
      "additionalProperties": false,
      "description": "The reserve's status (`scull headroom status`, `scull status`, the desktop).",
      "properties": {
        "detail": {
          "description": "Why it isn't ready, in one sentence.",
          "type": [
            "string",
            "null"
          ]
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeadroomManifest"
            },
            {
              "type": "null"
            }
          ],
          "description": "The manifest, when it could be read."
        },
        "path": {
          "description": "The reserve's path.",
          "type": "string"
        },
        "releasable_bytes": {
          "description": "Bytes releasing it would free now (its allocated size), when [`HeadroomState::Ready`].",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/HeadroomState",
          "description": "What it looks like."
        }
      },
      "required": [
        "state",
        "path"
      ],
      "type": "object"
    },
    "ReleaseOutcome": {
      "description": "How a release ended.",
      "oneOf": [
        {
          "const": "released",
          "description": "The reserve was removed; its space is free.",
          "type": "string"
        },
        {
          "const": "already_gone",
          "description": "The file was already gone; the manifest was removed.",
          "type": "string"
        }
      ]
    },
    "Released": {
      "description": "The result of a [`release`].",
      "properties": {
        "freed_bytes": {
          "description": "Bytes freed (the reserve's allocated size; 0 when it was already gone).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "manifest": {
          "$ref": "#/$defs/HeadroomManifest",
          "description": "The manifest of the reserve that was released."
        },
        "outcome": {
          "$ref": "#/$defs/ReleaseOutcome",
          "description": "How it ended."
        }
      },
      "required": [
        "outcome",
        "freed_bytes",
        "manifest"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One line of `--ndjson` output with schema scull/headroom@1: `type` selects the shape of `data`.",
  "properties": {
    "data": {
      "$ref": "#/$defs/HeadroomReport",
      "description": "The payload, as in the command's `--json` document."
    },
    "schema": {
      "const": "scull/headroom@1",
      "description": "`scull/<name>@<major>`.",
      "pattern": "^scull/[a-z][a-z0-9-]*@[1-9][0-9]*$",
      "type": "string"
    },
    "type": {
      "const": "headroom",
      "description": "The record type (one value per command, e.g. `status`).",
      "type": "string"
    },
    "version": {
      "description": "The scull version that wrote it.",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "version",
    "type",
    "data"
  ],
  "title": "scull/headroom@1 (NDJSON line)",
  "type": "object"
}
