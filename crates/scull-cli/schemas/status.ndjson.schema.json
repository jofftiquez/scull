{
  "$defs": {
    "FileIdentity": {
      "additionalProperties": false,
      "description": "Path-independent identity of a filesystem object (device/volume + inode/file ID).",
      "properties": {
        "file": {
          "description": "Inode / file ID as lowercase hex.",
          "pattern": "^[0-9a-f]{1,32}$",
          "type": "string"
        },
        "volume": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "volume",
        "file"
      ],
      "type": "object"
    },
    "ForecastConfidence": {
      "description": "How much to trust a forecast. Ordered: `Unknown < Low < Medium < High`.",
      "oneOf": [
        {
          "const": "unknown",
          "description": "Not enough history to say anything.",
          "type": "string"
        },
        {
          "const": "low",
          "description": "Short history, noisy data or a long extrapolation; not shown in status lines.",
          "type": "string"
        },
        {
          "const": "medium",
          "description": "Shown in status lines and may alert.",
          "type": "string"
        },
        {
          "const": "high",
          "description": "Long, regular history and a short extrapolation.",
          "type": "string"
        }
      ]
    },
    "ForecastReport": {
      "additionalProperties": false,
      "description": "One volume's disk-full forecast.",
      "properties": {
        "as_of": {
          "description": "When the latest sample was taken (Unix seconds).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/ForecastConfidence",
          "description": "`unknown`, `low`, `medium` or `high`. Status lines and alerts use `medium` and up."
        },
        "days_until_threshold": {
          "description": "Whole days until free space drops below the reserve (`filling`: at least 1;\n`below_reserve`: 0).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fill_bytes_per_day": {
          "description": "Free space lost per day by the trend, in bytes (negative when free space grows).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "free_bytes": {
          "description": "Latest free space (bytes), plus bytes known to be freed since.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reserve_bytes": {
          "description": "The free space the forecast counts down to (bytes).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "samples": {
          "description": "Samples the forecast used.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "span_secs": {
          "description": "Seconds between the first and the latest sample used.",
          "format": "int64",
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/ForecastState",
          "description": "`not_enough_history`, `not_filling`, `filling` or `below_reserve`."
        },
        "threshold_at": {
          "description": "When free space is forecast to drop below the reserve (Unix seconds).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "volume_id": {
          "description": "Volume identifier (mount point or volume GUID path).",
          "type": "string"
        }
      },
      "required": [
        "volume_id",
        "state",
        "confidence",
        "reserve_bytes",
        "samples",
        "span_secs"
      ],
      "type": "object"
    },
    "ForecastState": {
      "description": "What the forecast concluded.",
      "oneOf": [
        {
          "const": "not_enough_history",
          "description": "Too few samples or too short a span in the window; no extrapolation.",
          "type": "string"
        },
        {
          "const": "not_filling",
          "description": "Free space is stable or growing, or would take longer than the horizon to run out.",
          "type": "string"
        },
        {
          "const": "filling",
          "description": "Free space is shrinking: see `days_until_threshold`.",
          "type": "string"
        },
        {
          "const": "below_reserve",
          "description": "Free space is already at or below the reserve (measured, not forecast).",
          "type": "string"
        }
      ]
    },
    "HeadroomManifest": {
      "additionalProperties": false,
      "description": "What scull recorded when it created the reserve.",
      "properties": {
        "allocated_bytes": {
          "description": "Its allocated size when created (bytes): the space it really holds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "created_at": {
          "description": "When it was created (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "identity": {
          "$ref": "#/$defs/FileIdentity",
          "description": "Its no-follow identity when created."
        },
        "relative": {
          "description": "The reserve, relative to the data directory (always [`reserve_relative`]).",
          "type": "string"
        },
        "size_bytes": {
          "description": "Its logical size (bytes).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "description": "Format version ([`MANIFEST_VERSION`]).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "volume_id": {
          "description": "The volume it is on (mount point).",
          "type": "string"
        }
      },
      "required": [
        "version",
        "relative",
        "identity",
        "size_bytes",
        "allocated_bytes",
        "volume_id",
        "created_at"
      ],
      "type": "object"
    },
    "HeadroomState": {
      "description": "What the reserve looks like now.",
      "oneOf": [
        {
          "const": "none",
          "description": "No reserve (the default).",
          "type": "string"
        },
        {
          "const": "ready",
          "description": "The reserve exists and matches its manifest: it can be released.",
          "type": "string"
        },
        {
          "const": "missing",
          "description": "The manifest is there but the file is gone (released outside scull, or a release\nwhose record is missing). Releasing only removes the manifest.",
          "type": "string"
        },
        {
          "const": "changed",
          "description": "Something at the path differs from the manifest (identity, kind or size): scull will\nnot release it.",
          "type": "string"
        },
        {
          "const": "unreadable",
          "description": "The manifest can't be read: scull will not release anything.",
          "type": "string"
        },
        {
          "const": "unrecorded",
          "description": "A file is at the reserve's path but there is no manifest: scull didn't record it and\nwill not release it.",
          "type": "string"
        }
      ]
    },
    "HeadroomStatus": {
      "additionalProperties": false,
      "description": "The reserve's status (`scull headroom status`, `scull status`, the desktop).",
      "properties": {
        "detail": {
          "description": "Why it isn't ready, in one sentence.",
          "type": [
            "string",
            "null"
          ]
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeadroomManifest"
            },
            {
              "type": "null"
            }
          ],
          "description": "The manifest, when it could be read."
        },
        "path": {
          "description": "The reserve's path.",
          "type": "string"
        },
        "releasable_bytes": {
          "description": "Bytes releasing it would free now (its allocated size), when [`HeadroomState::Ready`].",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/HeadroomState",
          "description": "What it looks like."
        }
      },
      "required": [
        "state",
        "path"
      ],
      "type": "object"
    },
    "LastScanReport": {
      "additionalProperties": false,
      "description": "The latest usable scan.",
      "properties": {
        "age_secs": {
          "description": "Seconds between the finish and `now` (0 if the clock went backwards).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "candidates": {
          "description": "Candidates found.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "finished_at": {
          "description": "Finish time (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "reclaimable_bytes": {
          "description": "Reclaimable bytes of all candidates.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "safe_reclaimable_bytes": {
          "description": "Reclaimable bytes of S0 (regenerable) candidates.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "scan_id": {
          "description": "Scan identifier.",
          "type": "string"
        },
        "started_at": {
          "description": "Start time (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "description": "`completed` or `partial`.",
          "type": "string"
        }
      },
      "required": [
        "scan_id",
        "started_at",
        "finished_at",
        "status",
        "age_secs",
        "candidates",
        "reclaimable_bytes",
        "safe_reclaimable_bytes"
      ],
      "type": "object"
    },
    "ReviewPlanReport": {
      "additionalProperties": false,
      "description": "The review plan as reported by `scull check` / `scull status`.",
      "properties": {
        "created_at": {
          "description": "When it was prepared (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "expires_at": {
          "description": "When it expires (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "file": {
          "description": "The plan file.",
          "type": "string"
        },
        "includes_s1": {
          "description": "Whether S1 items were included (`--include-s1`).",
          "type": "boolean"
        },
        "items": {
          "description": "Items in the plan.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "plan_id": {
          "description": "The plan's ID (in the database's `plans` table).",
          "type": "string"
        },
        "reclaimable_bytes": {
          "description": "Estimated reclaimable bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "reused": {
          "description": "True when this check kept the existing plan (same work) instead of making a new one.",
          "type": "boolean"
        },
        "review_command": {
          "description": "The command that reviews it.",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "file",
        "items",
        "reclaimable_bytes",
        "created_at",
        "expires_at",
        "includes_s1",
        "review_command",
        "reused"
      ],
      "type": "object"
    },
    "StatusReport": {
      "additionalProperties": false,
      "description": "`scull status` output.",
      "properties": {
        "detail": {
          "description": "Why the status is unavailable, when it is.",
          "type": [
            "string",
            "null"
          ]
        },
        "forecasts": {
          "description": "Disk-full forecast of every volume ever sampled (PRO-01, D-22), by volume id.",
          "items": {
            "$ref": "#/$defs/ForecastReport"
          },
          "type": "array"
        },
        "headroom": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeadroomStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "The emergency headroom file (PRO-06), when there is one (or a leftover of one). The\nhuman line mentions a ready one; the prompt line does not."
        },
        "last_scan": {
          "anyOf": [
            {
              "$ref": "#/$defs/LastScanReport"
            },
            {
              "type": "null"
            }
          ],
          "description": "The latest completed or partial scan."
        },
        "line": {
          "description": "The human line (`scull status`), empty when there is nothing to show.",
          "type": "string"
        },
        "now": {
          "description": "When this report was produced (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "review_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewPlanReport"
            },
            {
              "type": "null"
            }
          ],
          "description": "The ready-to-review cleanup plan `scull check` prepared (PRO-05), while it is current.\nThe human line mentions it; the prompt line does not."
        },
        "short": {
          "description": "The prompt line (`scull status --short`), empty when there is nothing to show.",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/StatusState",
          "description": "Whether there is something to show."
        },
        "volumes": {
          "description": "Latest free-space sample of every volume ever sampled.",
          "items": {
            "$ref": "#/$defs/VolumeReport"
          },
          "type": "array"
        }
      },
      "required": [
        "state",
        "now",
        "volumes",
        "forecasts",
        "line",
        "short"
      ],
      "type": "object"
    },
    "StatusState": {
      "description": "Whether there is something to show.",
      "oneOf": [
        {
          "const": "ok",
          "description": "A usable scan is recorded.",
          "type": "string"
        },
        {
          "const": "no_scan",
          "description": "The database exists but holds no completed or partial scan yet.",
          "type": "string"
        },
        {
          "const": "no_database",
          "description": "No database yet (nothing was ever scanned).",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "The database can't be read by this command right now (newer schema, pending\nmigration, damaged, not a scull database, or the directories can't be located).",
          "type": "string"
        }
      ]
    },
    "VolumeReport": {
      "additionalProperties": false,
      "description": "One volume's latest free-space sample.",
      "properties": {
        "free_bytes": {
          "description": "Bytes available to the user.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sampled_at": {
          "description": "When it was sampled (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "total_bytes": {
          "description": "Volume size in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "volume_id": {
          "description": "Volume identifier (mount point or volume GUID path).",
          "type": "string"
        }
      },
      "required": [
        "volume_id",
        "total_bytes",
        "free_bytes",
        "sampled_at"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One line of `--ndjson` output with schema scull/status@1: `type` selects the shape of `data`.",
  "properties": {
    "data": {
      "$ref": "#/$defs/StatusReport",
      "description": "The payload, as in the command's `--json` document."
    },
    "schema": {
      "const": "scull/status@1",
      "description": "`scull/<name>@<major>`.",
      "pattern": "^scull/[a-z][a-z0-9-]*@[1-9][0-9]*$",
      "type": "string"
    },
    "type": {
      "const": "status",
      "description": "The record type (one value per command, e.g. `status`).",
      "type": "string"
    },
    "version": {
      "description": "The scull version that wrote it.",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "version",
    "type",
    "data"
  ],
  "title": "scull/status@1 (NDJSON line)",
  "type": "object"
}
