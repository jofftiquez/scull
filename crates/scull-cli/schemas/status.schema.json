{
  "$defs": {
    "ForecastConfidence": {
      "description": "How much to trust a forecast. Ordered: `Unknown < Low < Medium < High`.",
      "oneOf": [
        {
          "const": "unknown",
          "description": "Not enough history to say anything.",
          "type": "string"
        },
        {
          "const": "low",
          "description": "Short history, noisy data or a long extrapolation; not shown in status lines.",
          "type": "string"
        },
        {
          "const": "medium",
          "description": "Shown in status lines and may alert.",
          "type": "string"
        },
        {
          "const": "high",
          "description": "Long, regular history and a short extrapolation.",
          "type": "string"
        }
      ]
    },
    "ForecastReport": {
      "additionalProperties": false,
      "description": "One volume's disk-full forecast.",
      "properties": {
        "as_of": {
          "description": "When the latest sample was taken (Unix seconds).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/ForecastConfidence",
          "description": "`unknown`, `low`, `medium` or `high`. Status lines and alerts use `medium` and up."
        },
        "days_until_threshold": {
          "description": "Whole days until free space drops below the reserve (`filling`: at least 1;\n`below_reserve`: 0).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fill_bytes_per_day": {
          "description": "Free space lost per day by the trend, in bytes (negative when free space grows).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "free_bytes": {
          "description": "Latest free space (bytes), plus bytes known to be freed since.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reserve_bytes": {
          "description": "The free space the forecast counts down to (bytes).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "samples": {
          "description": "Samples the forecast used.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "span_secs": {
          "description": "Seconds between the first and the latest sample used.",
          "format": "int64",
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/ForecastState",
          "description": "`not_enough_history`, `not_filling`, `filling` or `below_reserve`."
        },
        "threshold_at": {
          "description": "When free space is forecast to drop below the reserve (Unix seconds).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "volume_id": {
          "description": "Volume identifier (mount point or volume GUID path).",
          "type": "string"
        }
      },
      "required": [
        "volume_id",
        "state",
        "confidence",
        "reserve_bytes",
        "samples",
        "span_secs"
      ],
      "type": "object"
    },
    "ForecastState": {
      "description": "What the forecast concluded.",
      "oneOf": [
        {
          "const": "not_enough_history",
          "description": "Too few samples or too short a span in the window; no extrapolation.",
          "type": "string"
        },
        {
          "const": "not_filling",
          "description": "Free space is stable or growing, or would take longer than the horizon to run out.",
          "type": "string"
        },
        {
          "const": "filling",
          "description": "Free space is shrinking: see `days_until_threshold`.",
          "type": "string"
        },
        {
          "const": "below_reserve",
          "description": "Free space is already at or below the reserve (measured, not forecast).",
          "type": "string"
        }
      ]
    },
    "LastScanReport": {
      "additionalProperties": false,
      "description": "The latest usable scan.",
      "properties": {
        "age_secs": {
          "description": "Seconds between the finish and `now` (0 if the clock went backwards).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "candidates": {
          "description": "Candidates found.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "finished_at": {
          "description": "Finish time (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "reclaimable_bytes": {
          "description": "Reclaimable bytes of all candidates.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "safe_reclaimable_bytes": {
          "description": "Reclaimable bytes of S0 (regenerable) candidates.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "scan_id": {
          "description": "Scan identifier.",
          "type": "string"
        },
        "started_at": {
          "description": "Start time (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "description": "`completed` or `partial`.",
          "type": "string"
        }
      },
      "required": [
        "scan_id",
        "started_at",
        "finished_at",
        "status",
        "age_secs",
        "candidates",
        "reclaimable_bytes",
        "safe_reclaimable_bytes"
      ],
      "type": "object"
    },
    "ReviewPlanReport": {
      "additionalProperties": false,
      "description": "The review plan as reported by `scull check` / `scull status`.",
      "properties": {
        "created_at": {
          "description": "When it was prepared (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "expires_at": {
          "description": "When it expires (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "file": {
          "description": "The plan file.",
          "type": "string"
        },
        "includes_s1": {
          "description": "Whether S1 items were included (`--include-s1`).",
          "type": "boolean"
        },
        "items": {
          "description": "Items in the plan.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "plan_id": {
          "description": "The plan's ID (in the database's `plans` table).",
          "type": "string"
        },
        "reclaimable_bytes": {
          "description": "Estimated reclaimable bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "reused": {
          "description": "True when this check kept the existing plan (same work) instead of making a new one.",
          "type": "boolean"
        },
        "review_command": {
          "description": "The command that reviews it.",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "file",
        "items",
        "reclaimable_bytes",
        "created_at",
        "expires_at",
        "includes_s1",
        "review_command",
        "reused"
      ],
      "type": "object"
    },
    "StatusReport": {
      "additionalProperties": false,
      "description": "`scull status` output.",
      "properties": {
        "detail": {
          "description": "Why the status is unavailable, when it is.",
          "type": [
            "string",
            "null"
          ]
        },
        "forecasts": {
          "description": "Disk-full forecast of every volume ever sampled (PRO-01, D-22), by volume id.",
          "items": {
            "$ref": "#/$defs/ForecastReport"
          },
          "type": "array"
        },
        "last_scan": {
          "anyOf": [
            {
              "$ref": "#/$defs/LastScanReport"
            },
            {
              "type": "null"
            }
          ],
          "description": "The latest completed or partial scan."
        },
        "line": {
          "description": "The human line (`scull status`), empty when there is nothing to show.",
          "type": "string"
        },
        "now": {
          "description": "When this report was produced (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "review_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewPlanReport"
            },
            {
              "type": "null"
            }
          ],
          "description": "The ready-to-review cleanup plan `scull check` prepared (PRO-05), while it is current.\nThe human line mentions it; the prompt line does not."
        },
        "short": {
          "description": "The prompt line (`scull status --short`), empty when there is nothing to show.",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/StatusState",
          "description": "Whether there is something to show."
        },
        "volumes": {
          "description": "Latest free-space sample of every volume ever sampled.",
          "items": {
            "$ref": "#/$defs/VolumeReport"
          },
          "type": "array"
        }
      },
      "required": [
        "state",
        "now",
        "volumes",
        "forecasts",
        "line",
        "short"
      ],
      "type": "object"
    },
    "StatusState": {
      "description": "Whether there is something to show.",
      "oneOf": [
        {
          "const": "ok",
          "description": "A usable scan is recorded.",
          "type": "string"
        },
        {
          "const": "no_scan",
          "description": "The database exists but holds no completed or partial scan yet.",
          "type": "string"
        },
        {
          "const": "no_database",
          "description": "No database yet (nothing was ever scanned).",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "The database can't be read by this command right now (newer schema, pending\nmigration, damaged, not a scull database, or the directories can't be located).",
          "type": "string"
        }
      ]
    },
    "VolumeReport": {
      "additionalProperties": false,
      "description": "One volume's latest free-space sample.",
      "properties": {
        "free_bytes": {
          "description": "Bytes available to the user.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sampled_at": {
          "description": "When it was sampled (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "total_bytes": {
          "description": "Volume size in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "volume_id": {
          "description": "Volume identifier (mount point or volume GUID path).",
          "type": "string"
        }
      },
      "required": [
        "volume_id",
        "total_bytes",
        "free_bytes",
        "sampled_at"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A JSON document: schema identifier, scull version and the payload.",
  "properties": {
    "data": {
      "$ref": "#/$defs/StatusReport",
      "description": "The payload."
    },
    "schema": {
      "const": "scull/status@1",
      "description": "Payload schema, `scull/<name>@<major>`.",
      "pattern": "^scull/[a-z][a-z0-9-]*@[1-9][0-9]*$",
      "type": "string"
    },
    "version": {
      "description": "The scull version that produced this document.",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "version",
    "data"
  ],
  "title": "scull/status@1",
  "type": "object"
}
