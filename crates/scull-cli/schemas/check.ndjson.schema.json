{
  "$defs": {
    "Alert": {
      "additionalProperties": false,
      "description": "One alert.",
      "properties": {
        "bytes": {
          "description": "The bytes concerned (stale total, budget usage, growth), when there is such a number.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "key": {
          "description": "Stable identity for de-duplication and responses: `<kind>:<subject>`.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AlertKind",
          "description": "What it is about."
        },
        "message": {
          "description": "One plain sentence for people (not terminal-escaped: callers escape on output).",
          "type": "string"
        },
        "paths": {
          "description": "The folders responsible (largest first, at most [`MAX_ALERT_PATHS`]); may be empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "raised_at": {
          "description": "When it was raised (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "description": "How urgent it is."
        },
        "subject": {
          "description": "The volume, category or path it concerns.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "severity",
        "key",
        "subject",
        "message",
        "raised_at",
        "paths"
      ],
      "type": "object"
    },
    "AlertKind": {
      "description": "What an alert is about.",
      "oneOf": [
        {
          "const": "disk_full_forecast",
          "description": "A volume is forecast to drop below its reserve soon (PRO-01: time-based, default\nwithin 14 days).",
          "type": "string"
        },
        {
          "const": "low_space",
          "description": "A volume is already below its reserve (measured).",
          "type": "string"
        },
        {
          "const": "stale",
          "description": "Worktrees, build outputs or caches idle longer than their staleness window (PRO-02).",
          "type": "string"
        },
        {
          "const": "worktree_ttl_expired",
          "description": "An agent or script worktree is past its registered TTL (PRO-08).",
          "type": "string"
        },
        {
          "const": "budget_exceeded",
          "description": "A category, ecosystem or path is over its size budget (PRO-03).",
          "type": "string"
        },
        {
          "const": "growth_spike",
          "description": "A category grew faster than the spike threshold (PRO-04).",
          "type": "string"
        },
        {
          "const": "free_space_drop",
          "description": "A volume lost free space faster than the spike threshold (PRO-04).",
          "type": "string"
        }
      ]
    },
    "AutoPolicyReport": {
      "additionalProperties": false,
      "description": "What the auto-policies did in this check.",
      "properties": {
        "caps": {
          "anyOf": [
            {
              "$ref": "#/$defs/Caps"
            },
            {
              "type": "null"
            }
          ],
          "description": "The caps, when checked."
        },
        "day_used_bytes": {
          "description": "Bytes auto-policies moved within the last 24 hours, before this run (from the audit\nlog), when checked.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "policies": {
          "description": "One entry per configured policy, when checked.",
          "items": {
            "$ref": "#/$defs/PolicyReport"
          },
          "type": "array"
        },
        "reason": {
          "description": "Why, when stopped or refused.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/RunState",
          "description": "Off, stopped by a kill switch, refused by a gate, or checked."
        }
      },
      "required": [
        "state",
        "policies"
      ],
      "type": "object"
    },
    "Caps": {
      "additionalProperties": false,
      "description": "The caps of a run, in items and bytes (from `[auto]`).",
      "properties": {
        "bytes_per_day": {
          "description": "Bytes within any 24 hours, all runs together.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "bytes_per_run": {
          "description": "Bytes per run, all policies together.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "items_per_run": {
          "description": "Items per run, all policies together.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "items_per_run",
        "bytes_per_run",
        "bytes_per_day"
      ],
      "type": "object"
    },
    "CheckReport": {
      "additionalProperties": false,
      "description": "`scull check` output.",
      "properties": {
        "alerts": {
          "description": "Alerts raised, most severe first.",
          "items": {
            "$ref": "#/$defs/Alert"
          },
          "type": "array"
        },
        "auto_policies": {
          "$ref": "#/$defs/AutoPolicyReport",
          "description": "Opt-in auto-policies (PRO-10, D-11): `off` unless the user enabled one."
        },
        "forecasts": {
          "description": "Disk-full forecast of every volume ever sampled, by volume id.",
          "items": {
            "$ref": "#/$defs/ForecastReport"
          },
          "type": "array"
        },
        "not_sampled": {
          "description": "Volumes known from history that could not be sampled now.",
          "items": {
            "$ref": "#/$defs/NotSampled"
          },
          "type": "array"
        },
        "now": {
          "description": "When the check ran (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "review_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewPlanReport"
            },
            {
              "type": "null"
            }
          ],
          "description": "The ready-to-review reclaim plan (PRO-05), when one is current. Never executed."
        },
        "sampled": {
          "description": "Free space sampled now (and recorded in history).",
          "items": {
            "$ref": "#/$defs/VolumeReport"
          },
          "type": "array"
        },
        "scan": {
          "$ref": "#/$defs/CheckScan",
          "description": "What was scanned."
        }
      },
      "required": [
        "now",
        "scan",
        "sampled",
        "not_sampled",
        "forecasts",
        "alerts",
        "auto_policies"
      ],
      "type": "object"
    },
    "CheckScan": {
      "description": "The scan a check ran (or why it did not).",
      "oneOf": [
        {
          "description": "No `scan.roots` configured: only history is used.",
          "properties": {
            "state": {
              "const": "not_configured",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "description": "`--no-scan`: only history is used.",
          "properties": {
            "state": {
              "const": "disabled",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "description": "The roots were not scanned; recorded history is used instead.",
          "properties": {
            "reason": {
              "description": "Why (e.g. a broad root that needs `scull scan --allow-broad-roots`).",
              "type": "string"
            },
            "state": {
              "const": "skipped",
              "type": "string"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The roots were scanned (and the scan recorded in history).",
          "properties": {
            "allocated_bytes": {
              "description": "Allocated bytes of everything found.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "candidates": {
              "description": "Candidates found.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "entries_scanned": {
              "description": "Entries counted.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "roots": {
              "description": "The roots scanned.",
              "items": {
                "$ref": "#/$defs/FsPath"
              },
              "type": "array"
            },
            "scan_id": {
              "$ref": "#/$defs/ScanId",
              "description": "The scan's ID."
            },
            "state": {
              "const": "scanned",
              "type": "string"
            }
          },
          "required": [
            "state",
            "scan_id",
            "roots",
            "candidates",
            "entries_scanned",
            "allocated_bytes"
          ],
          "type": "object"
        }
      ]
    },
    "Excluded": {
      "additionalProperties": false,
      "description": "Why candidates of the policy's kind were not chosen, counted.",
      "properties": {
        "activity_unknown": {
          "description": "Last activity unknown (never counted as idle).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "flagged": {
          "description": "In use, or flagged hardlinked, link, cloud placeholder or cross-mount (or not known\nnot to cross a mount).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "not_s0": {
          "description": "Not S0 (S1–S3 are never cleaned unattended).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "other_action": {
          "description": "S0, but its action is not the plain filesystem delete the policy turns into a\nquarantine, or its tier, reasons and action disagree.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "outside": {
          "description": "Outside the policy's `under` folders.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "project_active": {
          "description": "Its project's own files changed within the idle window, or that could not be told.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "recent": {
          "description": "Active within the policy's idle window.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "recently_restored": {
          "description": "The user restored it from quarantine within the policy's idle window.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "size_unknown": {
          "description": "Its size is unknown or zero (nothing to charge to the caps honestly).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "not_s0",
        "other_action",
        "flagged",
        "activity_unknown",
        "recent",
        "outside",
        "size_unknown",
        "recently_restored",
        "project_active"
      ],
      "type": "object"
    },
    "ForecastConfidence": {
      "description": "How much to trust a forecast. Ordered: `Unknown < Low < Medium < High`.",
      "oneOf": [
        {
          "const": "unknown",
          "description": "Not enough history to say anything.",
          "type": "string"
        },
        {
          "const": "low",
          "description": "Short history, noisy data or a long extrapolation; not shown in status lines.",
          "type": "string"
        },
        {
          "const": "medium",
          "description": "Shown in status lines and may alert.",
          "type": "string"
        },
        {
          "const": "high",
          "description": "Long, regular history and a short extrapolation.",
          "type": "string"
        }
      ]
    },
    "ForecastReport": {
      "additionalProperties": false,
      "description": "One volume's disk-full forecast.",
      "properties": {
        "as_of": {
          "description": "When the latest sample was taken (Unix seconds).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/ForecastConfidence",
          "description": "`unknown`, `low`, `medium` or `high`. Status lines and alerts use `medium` and up."
        },
        "days_until_threshold": {
          "description": "Whole days until free space drops below the reserve (`filling`: at least 1;\n`below_reserve`: 0).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fill_bytes_per_day": {
          "description": "Free space lost per day by the trend, in bytes (negative when free space grows).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "free_bytes": {
          "description": "Latest free space (bytes), plus bytes known to be freed since.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reserve_bytes": {
          "description": "The free space the forecast counts down to (bytes).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "samples": {
          "description": "Samples the forecast used.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "span_secs": {
          "description": "Seconds between the first and the latest sample used.",
          "format": "int64",
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/ForecastState",
          "description": "`not_enough_history`, `not_filling`, `filling` or `below_reserve`."
        },
        "threshold_at": {
          "description": "When free space is forecast to drop below the reserve (Unix seconds).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "volume_id": {
          "description": "Volume identifier (mount point or volume GUID path).",
          "type": "string"
        }
      },
      "required": [
        "volume_id",
        "state",
        "confidence",
        "reserve_bytes",
        "samples",
        "span_secs"
      ],
      "type": "object"
    },
    "ForecastState": {
      "description": "What the forecast concluded.",
      "oneOf": [
        {
          "const": "not_enough_history",
          "description": "Too few samples or too short a span in the window; no extrapolation.",
          "type": "string"
        },
        {
          "const": "not_filling",
          "description": "Free space is stable or growing, or would take longer than the horizon to run out.",
          "type": "string"
        },
        {
          "const": "filling",
          "description": "Free space is shrinking: see `days_until_threshold`.",
          "type": "string"
        },
        {
          "const": "below_reserve",
          "description": "Free space is already at or below the reserve (measured, not forecast).",
          "type": "string"
        }
      ]
    },
    "FsPath": {
      "description": "A filesystem path as it appears in plans, JSON output and the database.\n\nSerialized as a string. Paths that aren't valid Unicode (possible on Unix and Windows) are\nconverted lossily with U+FFFD and flagged by [`FsPath::is_lossy`]; the engine never acts on\na path read back from JSON alone. Items are matched by [`crate::ItemId`] and file identity,\nand candidates are re-derived from the disk before execution (SAFE-05, SAFE-11).",
      "type": "string"
    },
    "ItemId": {
      "description": "Stable item ID: 128-bit truncated SHA-256 of identity + path, lowercase hex.",
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    },
    "NotSampled": {
      "additionalProperties": false,
      "description": "A volume known from history that was not sampled.",
      "properties": {
        "reason": {
          "description": "Why: e.g. `not connected`.",
          "type": "string"
        },
        "volume_id": {
          "description": "Volume identifier as recorded.",
          "type": "string"
        }
      },
      "required": [
        "volume_id",
        "reason"
      ],
      "type": "object"
    },
    "PolicyItem": {
      "additionalProperties": false,
      "description": "One item of a policy's preview or run.",
      "properties": {
        "bytes": {
          "description": "Estimated bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "item_id": {
          "$ref": "#/$defs/ItemId",
          "description": "Stable item ID."
        },
        "outcome": {
          "description": "`would_quarantine` (preview), `quarantined`, `trashed`, or the reason code it was left\nin place (e.g. `tier_raised`, `now_protected`, `identity_changed`, `in_use`).",
          "type": "string"
        },
        "path": {
          "description": "Its path.",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "path",
        "bytes",
        "outcome"
      ],
      "type": "object"
    },
    "PolicyOutcome": {
      "description": "What one policy did.",
      "oneOf": [
        {
          "description": "Not enabled (`enabled = true` is missing).",
          "properties": {
            "state": {
              "const": "disabled",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "description": "Its definition is invalid; it never runs until fixed.",
          "properties": {
            "reason": {
              "description": "Why.",
              "type": "string"
            },
            "state": {
              "const": "invalid",
              "type": "string"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "Dry run (first time, or the definition changed): nothing was touched.",
          "properties": {
            "bytes": {
              "description": "Their bytes.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "items": {
              "description": "Items it would quarantine.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "runs_after": {
              "description": "The earliest check that may run it for real.",
              "format": "int64",
              "type": "integer"
            },
            "state": {
              "const": "previewed",
              "type": "string"
            }
          },
          "required": [
            "state",
            "items",
            "bytes",
            "runs_after"
          ],
          "type": "object"
        },
        {
          "description": "Ran recently; it may run again at `next_at`.",
          "properties": {
            "next_at": {
              "description": "Unix seconds.",
              "format": "int64",
              "type": "integer"
            },
            "state": {
              "const": "not_due",
              "type": "string"
            }
          },
          "required": [
            "state",
            "next_at"
          ],
          "type": "object"
        },
        {
          "description": "Due, but nothing qualifies (or the caps left no room: see `deferred`).",
          "properties": {
            "state": {
              "const": "nothing_to_do",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "description": "Planned by [`prepare`], not run yet (only seen between [`prepare`] and [`execute`]).",
          "properties": {
            "items": {
              "description": "Items planned.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "state": {
              "const": "planned",
              "type": "string"
            }
          },
          "required": [
            "state",
            "items"
          ],
          "type": "object"
        },
        {
          "description": "Ran: one audited operation.",
          "properties": {
            "bytes": {
              "description": "Bytes moved.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "not_done": {
              "description": "Items left in place (skipped at revalidation, refused or blocked).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "operation_id": {
              "description": "`scull history <id>`, `scull restore <id>`.",
              "type": "string"
            },
            "quarantined": {
              "description": "Items moved into quarantine.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "restore_command": {
              "description": "How to undo it.",
              "type": "string"
            },
            "state": {
              "const": "ran",
              "type": "string"
            },
            "trashed": {
              "description": "Items moved to the Trash (quarantine impossible there).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "state",
            "operation_id",
            "quarantined",
            "trashed",
            "not_done",
            "bytes",
            "restore_command"
          ],
          "type": "object"
        },
        {
          "description": "Could not run (e.g. another scull operation holds the execution lock); retried at the\nnext check. Nothing was touched unless an operation is named.",
          "properties": {
            "operation_id": {
              "description": "The operation, if one was started.",
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "description": "Why.",
              "type": "string"
            },
            "state": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "PolicyReport": {
      "additionalProperties": false,
      "description": "One policy in this check.",
      "properties": {
        "deferred": {
          "description": "Items it chose but the caps deferred to a later run.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "excluded": {
          "$ref": "#/$defs/Excluded",
          "description": "Candidates of its kind it left out, by reason."
        },
        "items": {
          "description": "Items it would clean (preview) or handled (run), oldest first, at most\n[`ITEMS_LISTED`].",
          "items": {
            "$ref": "#/$defs/PolicyItem"
          },
          "type": "array"
        },
        "name": {
          "description": "The policy's name.",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/PolicyOutcome",
          "description": "What it did."
        }
      },
      "required": [
        "name",
        "outcome",
        "items",
        "deferred",
        "excluded"
      ],
      "type": "object"
    },
    "ReviewPlanReport": {
      "additionalProperties": false,
      "description": "The review plan as reported by `scull check` / `scull status`.",
      "properties": {
        "created_at": {
          "description": "When it was prepared (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "expires_at": {
          "description": "When it expires (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "file": {
          "description": "The plan file.",
          "type": "string"
        },
        "includes_s1": {
          "description": "Whether S1 items were included (`--include-s1`).",
          "type": "boolean"
        },
        "items": {
          "description": "Items in the plan.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "plan_id": {
          "description": "The plan's ID (in the database's `plans` table).",
          "type": "string"
        },
        "reclaimable_bytes": {
          "description": "Estimated reclaimable bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "reused": {
          "description": "True when this check kept the existing plan (same work) instead of making a new one.",
          "type": "boolean"
        },
        "review_command": {
          "description": "The command that reviews it.",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "file",
        "items",
        "reclaimable_bytes",
        "created_at",
        "expires_at",
        "includes_s1",
        "review_command",
        "reused"
      ],
      "type": "object"
    },
    "RunState": {
      "description": "The overall state of the auto-policies in this check.",
      "oneOf": [
        {
          "const": "off",
