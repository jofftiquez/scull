        },
        {
          "const": "critical",
          "description": "Act now.",
          "type": "string"
        }
      ]
    },
    "VolumeReport": {
      "additionalProperties": false,
      "description": "One volume's latest free-space sample.",
      "properties": {
        "free_bytes": {
          "description": "Bytes available to the user.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sampled_at": {
          "description": "When it was sampled (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "total_bytes": {
          "description": "Volume size in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "volume_id": {
          "description": "Volume identifier (mount point or volume GUID path).",
          "type": "string"
        }
      },
      "required": [
        "volume_id",
        "total_bytes",
        "free_bytes",
        "sampled_at"
      ],
      "type": "object"
    }
  },
