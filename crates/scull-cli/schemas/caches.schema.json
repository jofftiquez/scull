{
  "$defs": {
    "Action": {
      "description": "The action proposed for a candidate.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "No action: the item is blocked (S3) or inspect-only.",
          "properties": {
            "type": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Delete through the safe executor (S0 default, D-3). Restore path is regeneration.",
          "properties": {
            "type": {
              "const": "delete",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Atomic same-volume move into `.scull-quarantine/<operation-id>/` (S1/S2 default).",
          "properties": {
            "type": {
              "const": "quarantine",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Move to the platform Trash / Recycle Bin (fallback when quarantine isn't possible).",
          "properties": {
            "type": {
              "const": "trash",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Run a tool's own cleanup command (package caches, Docker; SAFE-06, QC-03).",
          "properties": {
            "args": {
              "description": "Structured arguments (no shell), e.g. `[\"cache\", \"verify\"]`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "tool": {
              "description": "Tool name, e.g. \"npm\".",
              "type": "string"
            },
            "type": {
              "const": "tool_command",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tool",
            "args"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`git worktree remove` (never `--force` unless authorized per item).",
          "properties": {
            "type": {
              "const": "git_worktree_remove",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`git worktree prune` for a stale registration.",
          "properties": {
            "type": {
              "const": "git_worktree_prune",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "CacheCommandLine": {
      "additionalProperties": false,
      "description": "The cleanup command of one cache candidate (the \"Cleanup commands\" line of the human\nreport).",
      "properties": {
        "command": {
          "description": "The preferred native command (`npm cache verify`); `null` when inspect-only or unknown.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/ItemId",
          "description": "ID of the candidate."
        },
        "rule": {
          "description": "Rule ID of the cache (e.g. `npm.cache`).",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CacheCommandStatus",
          "description": "Whether the command is offered."
        },
        "text": {
          "description": "The line as printed, e.g. `npm cache verify` or\n`none (inspect-only: no native cleanup command)`.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "rule",
        "status",
        "text"
      ],
      "type": "object"
    },
    "CacheCommandStatus": {
      "description": "Whether, and how, `scull clean caches` would clean one cache.",
      "oneOf": [
        {
          "const": "offered",
          "description": "The tool's native command is offered at the cache's tier.",
          "type": "string"
        },
        {
          "const": "not_offered",
          "description": "The tool has a native command, but it is not offered at the cache's tier.",
          "type": "string"
        },
        {
          "const": "inspect_only",
          "description": "The tool has no native cleanup command (Gradle, Maven): the cache is shown and\nmeasured, never cleaned.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Not a cache rule scull knows the commands of.",
          "type": "string"
        }
      ]
    },
    "CachesDocument": {
      "additionalProperties": false,
      "description": "`scull caches --json` data: the engine's report plus the cleanup command of each candidate.",
      "properties": {
        "cancelled": {
          "description": "`true` when the user cancelled while sizing.",
          "type": "boolean"
        },
        "candidates": {
          "description": "One candidate per cache found (category `package_cache`).",
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "type": "array"
        },
        "commands": {
          "default": [],
          "description": "The cleanup command of each candidate, in the order of `candidates` (added in 1.x;\nabsent in older output).",
          "items": {
            "$ref": "#/$defs/CacheCommandLine"
          },
          "type": "array"
        },
        "issues": {
          "description": "Places that could not be read.",
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "type": "array"
        },
        "measured_at": {
          "description": "Unix time (seconds) of the measurement.",
          "format": "int64",
          "type": "integer"
        },
        "refused": {
          "description": "Tools whose cache location was refused (QC-05); nothing of them is offered.",
          "items": {
            "$ref": "#/$defs/RefusedCacheReport"
          },
          "type": "array"
        },
        "signals_unavailable": {
          "description": "Signals this run could not observe.",
          "items": {
            "$ref": "#/$defs/SignalUnavailable"
          },
          "type": "array"
        },
        "totals": {
          "$ref": "#/$defs/Totals",
          "description": "Totals over the candidates."
        }
      },
      "required": [
        "measured_at",
        "cancelled",
        "candidates",
        "refused",
        "totals",
        "signals_unavailable",
        "issues"
      ],
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "description": "A detected item with a risk tier and evidence. This is the unit the preview shows, plans\nreference and the executor revalidates.",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action",
          "description": "Proposed action."
        },
        "artifact": {
          "description": "Human-readable artifact type, e.g. \"Cargo build output\".",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/Category",
          "description": "Category for grouping."
        },
        "evidence": {
          "description": "Detection evidence.",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "flags": {
          "$ref": "#/$defs/Flags",
          "description": "Risk flags."
        },
        "id": {
          "$ref": "#/$defs/ItemId",
          "description": "Stable ID (identity + path)."
        },
        "identity": {
          "$ref": "#/$defs/FileIdentity",
          "description": "File identity at scan time; revalidation compares against it (SAFE-05)."
        },
        "path": {
          "$ref": "#/$defs/FsPath",
          "description": "Exact path."
        },
        "project": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Owning project, if any."
        },
        "reasons": {
          "description": "Every rubric row that fired.",
          "items": {
            "$ref": "#/$defs/TierReason"
          },
          "type": "array"
        },
        "regeneration": {
          "$ref": "#/$defs/Regeneration",
          "description": "Regeneration instructions and cost."
        },
        "rule": {
          "$ref": "#/$defs/RuleRef",
          "description": "Rule that produced the candidate."
        },
        "sizes": {
          "$ref": "#/$defs/Sizes",
          "description": "Logical, allocated and reclaimable bytes."
        },
        "tier": {
          "$ref": "#/$defs/Tier",
          "description": "Tier: always the most protective of `reasons` (see [`Candidate::is_consistent`])."
        }
      },
      "required": [
        "id",
        "path",
        "identity",
        "category",
        "artifact",
        "rule",
        "tier",
        "reasons",
        "evidence",
        "sizes",
        "flags",
        "regeneration",
        "action"
      ],
      "type": "object"
    },
    "Category": {
      "description": "Broad category of a candidate, used for grouping in the CLI, charts and Quick Clean.",
      "oneOf": [
        {
          "const": "project_artifact",
          "description": "Build output or dependencies inside a project (`target/`, `node_modules`, `.next`, …).",
          "type": "string"
        },
        {
          "const": "package_cache",
          "description": "Global package-manager cache (Quick Clean, QC-01).",
          "type": "string"
        },
        {
          "const": "worktree",
          "description": "A Git worktree, whole or stale registration.",
          "type": "string"
        },
        {
          "const": "ml_cache",
          "description": "ML/AI model or dataset cache.",
          "type": "string"
        },
        {
          "const": "container",
          "description": "Docker / container data.",
          "type": "string"
        },
        {
          "const": "large_file",
          "description": "Large file surfaced for inspection only.",
          "type": "string"
        },
        {
          "const": "scull_data",
          "description": "scull's own data (database, logs, quarantine; DATA-05).",
          "type": "string"
        },
        {
          "const": "other",
          "description": "Anything else.",
          "type": "string"
        }
      ]
    },
    "Confidence": {
      "description": "How confident the engine is in a reclaim estimate (PRD §9).",
      "oneOf": [
        {
          "const": "high",
          "description": "No sharing, snapshots or clones could affect the result.",
          "type": "string"
        },
        {
          "const": "medium",
          "description": "Minor uncertainty (e.g. compression we measured but can't fully attribute).",
          "type": "string"
        },
        {
          "const": "low",
          "description": "Shared extents, clones or snapshots may pin some bytes.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "The engine can't estimate; only the measured delta will tell.",
          "type": "string"
        }
      ]
    },
    "Evidence": {
      "description": "A fact observed about a candidate. Evidence is what the preview shows under \"why\".\n\nMissing evidence never counts as evidence of inactivity (PRD §8.4): when a signal can't be\nread, record [`Evidence::SignalUnavailable`] instead of omitting it.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A project marker at the expected relative location (e.g. `Cargo.toml` beside `target/`).\nCLS-03: a directory name alone is never enough.",
          "properties": {
            "kind": {
              "const": "marker",
              "type": "string"
            },
            "path": {
              "$ref": "#/$defs/FsPath",
              "description": "Path of the marker file."
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A lockfile or manifest the artifact can be reproduced from.",
          "properties": {
            "kind": {
              "const": "lockfile",
              "type": "string"
            },
            "path": {
              "$ref": "#/$defs/FsPath",
              "description": "Path of the lockfile."
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The artifact type is known to a rule.",
          "properties": {
            "artifact": {
              "description": "Human-readable artifact type, e.g. \"Cargo build output\".",
              "type": "string"
            },
            "kind": {
              "const": "known_artifact",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "artifact"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Files inside the candidate are tracked by Git.",
          "properties": {
            "files": {
              "description": "Number of tracked files found (may be a lower bound).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "git_tracked",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "files"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The path is inside a protected root (SAFE-03).",
          "properties": {
            "kind": {
              "const": "protected_root",
              "type": "string"
            },
            "root": {
              "$ref": "#/$defs/FsPath",
              "description": "The protected root."
            }
          },
          "required": [
            "kind",
            "root"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The user excluded this path in config.",
          "properties": {
            "kind": {
              "const": "user_exclusion",
              "type": "string"
            },
            "rule": {
              "description": "The exclusion entry that matched.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "rule"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A `.scull-protect` marker covers this path.",
          "properties": {
            "kind": {
              "const": "protect_marker",
              "type": "string"
            },
            "path": {
              "$ref": "#/$defs/FsPath",
              "description": "Path of the marker."
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The candidate is in use right now.",
          "properties": {
            "by": {
              "description": "Process name or tool, if known.",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "in_use",
              "type": "string"
            },
            "signal": {
              "description": "What showed it, e.g. \"open handle\", \"process cwd\", \"cargo lock\".",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "signal"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Newest modification inside the candidate, sampled with a bound.",
          "properties": {
            "kind": {
              "const": "last_modified",
              "type": "string"
            },
            "newest_unix": {
              "description": "Unix timestamp (seconds, UTC) of the newest observed mtime.",
              "format": "int64",
              "type": "integer"
            },
            "sampled": {
              "description": "Whether sampling hit its bound (the true newest may be later).",
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "newest_unix",
            "sampled"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The candidate crosses a mount or volume boundary.",
          "properties": {
            "kind": {
              "const": "crosses_mount",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Reached through a symlink or junction pointing outside the scan root.",
          "properties": {
            "kind": {
              "const": "link_escape",
              "type": "string"
            },
            "target": {
              "$ref": "#/$defs/FsPath",
              "description": "Where the link points."
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Cloud-sync placeholder or synced folder (iCloud, OneDrive, Dropbox). Never hydrated.",
          "properties": {
            "kind": {
              "const": "cloud_sync",
              "type": "string"
            },
            "provider": {
              "description": "Provider name.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Hardlinks shared with something outside the candidate (e.g. pnpm store).",
          "properties": {
            "kind": {
              "const": "hardlinked",
              "type": "string"
            },
            "shared_bytes": {
              "description": "Bytes shared with other links.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "shared_bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A signal could not be read on this platform or with current permissions.",
          "properties": {
            "kind": {
              "const": "signal_unavailable",
              "type": "string"
            },
            "reason": {
              "description": "Why, e.g. \"needs Full Disk Access\".",
              "type": "string"
            },
            "signal": {
              "description": "Which signal, e.g. \"open files\".",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "signal",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Free-form note from a detector (shown, never used for tiering).",
          "properties": {
            "kind": {
              "const": "note",
              "type": "string"
            },
            "text": {
              "description": "The note.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        }
      ]
    },
    "FileIdentity": {
      "additionalProperties": false,
      "description": "Path-independent identity of a filesystem object (device/volume + inode/file ID).",
      "properties": {
        "file": {
          "description": "Inode / file ID as lowercase hex.",
          "pattern": "^[0-9a-f]{1,32}$",
          "type": "string"
        },
        "volume": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "volume",
        "file"
      ],
      "type": "object"
    },
    "Flags": {
      "additionalProperties": false,
      "description": "Risk flags shown with every candidate (SAFE-01). `None` means \"not checked / unknown\",\nwhich is never treated as \"no\".",
      "properties": {
        "active": {
          "description": "In use by a process or tool.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "cloud_placeholder": {
          "description": "Is or contains a cloud-sync placeholder.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "cross_mount": {
          "description": "Crosses a mount/volume boundary.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "hardlinked": {
          "description": "Contains hardlinks shared outside the candidate.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "symlink": {
          "description": "Is or contains a symlink/junction.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "FsPath": {
      "description": "A filesystem path as it appears in plans, JSON output and the database.\n\nSerialized as a string. Paths that aren't valid Unicode (possible on Unix and Windows) are\nconverted lossily with U+FFFD and flagged by [`FsPath::is_lossy`]; the engine never acts on\na path read back from JSON alone. Items are matched by [`crate::ItemId`] and file identity,\nand candidates are re-derived from the disk before execution (SAFE-05, SAFE-11).",
      "type": "string"
    },
    "Issue": {
      "additionalProperties": false,
      "description": "Something the scan could not read or did not descend into.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/IssueKind",
          "description": "What kind of issue."
        },
        "message": {
          "description": "Human explanation.",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/FsPath",
          "description": "Where."
        }
      },
      "required": [
        "path",
        "kind",
        "message"
      ],
      "type": "object"
    },
    "IssueKind": {
      "description": "Kinds of [`Issue`].",
      "oneOf": [
        {
          "const": "permission_denied",
          "description": "Permission denied.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "Vanished while scanning.",
          "type": "string"
        },
        {
          "const": "timed_out",
          "description": "Listing took too long.",
          "type": "string"
        },
        {
          "const": "read_error",
          "description": "Another read error.",
          "type": "string"
        },
        {
          "const": "other_volume",
          "description": "On another volume: counted, not descended.",
          "type": "string"
        },
        {
          "const": "loop",
          "description": "A directory loop: not descended.",
          "type": "string"
        },
        {
          "const": "max_depth",
          "description": "Depth limit: not descended.",
          "type": "string"
        },
        {
          "const": "cloud_placeholder",
          "description": "A cloud-sync placeholder (iCloud/File Provider dataless, OneDrive recall-on-access):\nnever listed so nothing gets downloaded (PLT-04); counted from metadata only.",
          "type": "string"
        },
        {
          "const": "not_descended",
          "description": "Not descended for another scanner reason.",
          "type": "string"
        },
        {
          "const": "git",
          "description": "A Git operation failed.",
          "type": "string"
        },
        {
          "const": "outside_roots",
          "description": "Something outside the scan roots that was not measured.",
          "type": "string"
        },
        {
          "const": "history",
          "description": "History could not be recorded.",
          "type": "string"
        }
      ]
    },
    "ItemId": {
      "description": "Stable item ID: 128-bit truncated SHA-256 of identity + path, lowercase hex.",
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    },
    "ProjectRef": {
      "additionalProperties": false,
      "description": "The project or repository that owns a candidate.",
      "properties": {
        "ecosystem": {
          "description": "Ecosystem, e.g. \"rust\", \"node\".",
          "type": "string"
        },
        "name": {
          "description": "Display name (usually the directory name or manifest name).",
          "type": "string"
        },
        "root": {
          "$ref": "#/$defs/FsPath",
          "description": "Project root directory."
        }
      },
      "required": [
        "root",
        "name",
        "ecosystem"
      ],
      "type": "object"
    },
    "ReasonCode": {
      "description": "Stable codes for tier reasons. Matches the rows of the rubric (PRD §8.3) and the worktree\ndecision table (GIT-03). New codes may be added; existing ones never change meaning.",
      "oneOf": [
        {
          "const": "git_tracked",
          "description": "Contains Git-tracked files → S3.",
          "type": "string"
        },
        {
          "const": "protected_root",
          "description": "Inside a protected root → S3.",
          "type": "string"
        },
        {
          "const": "user_exclusion",
          "description": "Matches a user exclusion → S3.",
          "type": "string"
        },
        {
          "const": "protect_marker",
          "description": "Covered by `.scull-protect` → S3.",
          "type": "string"
        },
        {
          "const": "in_use",
          "description": "In use (open handles, process cwd, held lock) → S3 for this run.",
          "type": "string"
        },
        {
          "const": "crosses_mount",
          "description": "Crosses a mount/volume boundary → S3.",
          "type": "string"
        },
        {
          "const": "link_escape",
          "description": "Reached via a link outside the scan root → S3.",
          "type": "string"
        },
        {
          "const": "cloud_sync",
          "description": "Cloud placeholder or synced folder → S2.",
          "type": "string"
        },
        {
          "const": "no_lockfile",
          "description": "Marker found but nothing to reproduce from → S2.",
          "type": "string"
        },
        {
          "const": "recent_activity",
          "description": "Modified within the activity window → one tier more protective.",
          "type": "string"
        },
        {
          "const": "signal_unavailable",
          "description": "A required signal was unavailable, so the engine assumed the protective answer.",
          "type": "string"
        },
        {
          "const": "costly_to_regenerate",
          "description": "Reproducible, but needs network or a long build → S1.",
          "type": "string"
        },
        {
          "const": "regenerable",
          "description": "Reproducible from local inputs or quickly → S0.",
          "type": "string"
        },
        {
          "const": "worktree_locked",
          "description": "Worktree is locked → S3.",
          "type": "string"
        },
        {
          "const": "worktree_dirty",
          "description": "Worktree has uncommitted or untracked changes → S3.",
          "type": "string"
        },
        {
          "const": "worktree_unique_ignored",
          "description": "Worktree has ignored files not matched by an artifact rule → ≥ S2.",
          "type": "string"
        },
        {
          "const": "unpushed_commits",
          "description": "Commits not reachable from any remote-tracking ref and not provably merged → S3.",
          "type": "string"
        },
        {
          "const": "orphan_head",
          "description": "Detached HEAD at a commit reachable from no ref → S3.",
          "type": "string"
        },
        {
          "const": "merge_unproven",
          "description": "Merge detected only heuristically → S2.",
          "type": "string"
        },
        {
          "const": "worktree_clean",
          "description": "Clean, unlocked, everything pushed or merged → S1 (never S0).",
          "type": "string"
        },
        {
          "const": "stale_worktree_registration",
          "description": "Registered worktree whose directory is gone → S0 (metadata only).",
          "type": "string"
        },
        {
          "const": "package_cache",
          "description": "Package cache: re-downloadable → S1 (QC-02).",
          "type": "string"
        },
        {
          "const": "inspect_only",
          "description": "Large file surfaced for inspection only → S2.",
          "type": "string"
        }
      ]
    },
    "Reclaimable": {
      "additionalProperties": false,
      "description": "Physically reclaimable bytes plus the confidence of that estimate.",
      "properties": {
        "bytes": {
          "description": "Estimated bytes freed. With `Confidence::Unknown` this is a best guess, not a promise.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "description": "How much to trust `bytes`."
        },
        "shared_bytes": {
          "default": 0,
          "description": "Bytes shared with something else (e.g. hardlinked into the pnpm store) that removing\nthis item will not free while the other links remain.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "bytes",
        "confidence"
      ],
      "type": "object"
    },
    "RefusedCacheReport": {
      "additionalProperties": false,
      "description": "A tool whose cache location was refused.",
      "properties": {
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/FsPath"
            },
            {
              "type": "null"
            }
          ],
          "description": "The refused location, if known."
        },
        "reason": {
          "description": "Why it was refused.",
          "type": "string"
        },
        "rule": {
          "description": "Rule ID of the tool (e.g. `cache.npm`).",
          "type": "string"
        },
        "source": {
          "description": "Where it came from.",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "source",
        "reason"
      ],
      "type": "object"
    },
    "Regeneration": {
      "additionalProperties": false,
      "description": "How to get an item back after removal, and roughly what it costs (D-5: \"unknown\" unless\nthere is evidence).",
      "properties": {
        "cost": {
          "$ref": "#/$defs/RegenerationCost",
          "description": "Estimated cost."
        },
        "instructions": {
          "description": "Instructions, e.g. \"cargo build\".",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "cost"
      ],
      "type": "object"
    },
    "RegenerationCost": {
      "description": "Estimated cost of regenerating an item.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "No evidence to estimate from (default, D-5).",
          "properties": {
            "type": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An estimate backed by evidence.",
          "properties": {
            "network": {
              "description": "Whether regeneration needs network access.",
              "type": "boolean"
            },
            "seconds": {
              "description": "Approximate seconds to regenerate.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "estimate",
              "type": "string"
            }
          },
          "required": [
            "type",
            "seconds",
            "network"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Cannot be regenerated (unique data).",
          "properties": {
            "type": {
              "const": "not_regenerable",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "RuleRef": {
      "additionalProperties": false,
      "description": "Reference to the detector rule that produced a candidate (CLS-01).",
      "properties": {
        "id": {
          "description": "Rule ID, e.g. `rust.target`.",
          "type": "string"
        },
        "version": {
          "description": "Rule version; bumps whenever the rule's matching or tiering changes.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "SignalUnavailable": {
      "additionalProperties": false,
      "description": "A safety signal the run could not observe.",
      "properties": {
        "affected": {
          "description": "How many candidates it affected.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "reason": {
          "description": "Why, and what scull did instead.",
          "type": "string"
        },
        "signal": {
          "description": "Stable signal name (`in_use`, `git`, ...).",
          "type": "string"
        }
      },
      "required": [
        "signal",
        "reason",
        "affected"
      ],
      "type": "object"
    },
    "Sizes": {
      "additionalProperties": false,
      "description": "The three size figures for an item.",
      "properties": {
        "allocated": {
          "description": "Blocks actually allocated on disk (accounts for sparse files and compression).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "logical": {
          "description": "Sum of file lengths (`st_size` / end-of-file).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "reclaimable": {
          "$ref": "#/$defs/Reclaimable",
          "description": "Estimated free-space increase if the item were removed now."
        }
      },
      "required": [
        "logical",
        "allocated",
        "reclaimable"
      ],
      "type": "object"
    },
    "Tier": {
      "description": "How much risk removing an item carries.\n\nThe ordering is by **protectiveness**: `S0 < S1 < S2 < S3`. Combining evidence always takes\nthe maximum (the most protective tier), and a tier may only ever move *up* this order after a\nscan (invariant I-8: tiers never decrease on revalidation).",
      "oneOf": [
        {
          "const": "S0",
          "description": "Regenerable: a verified generated artifact, reproducible from tracked inputs.\nPreselected for review, but never executed without confirmation.",
          "type": "string"
        },
        {
          "const": "S1",
          "description": "Costly to recreate: reproducible, but needs a significant download or build. Opt-in.",
          "type": "string"
        },
        {
          "const": "S2",
          "description": "Uncertain: ownership, activity or reproducibility is unclear. Never preselected.",
          "type": "string"
        },
        {
          "const": "S3",
          "description": "Protected: possibly unique data, in active use, or explicitly protected. Never acted on.",
          "type": "string"
        }
      ]
    },
    "TierBreakdown": {
      "description": "Bytes per tier, used to aggregate parent nodes for charts (PRD §8.3 \"Aggregation\").\n\nA parent's *badge* is the most protective tier that has any bytes; charts must never color a\nparent as safe when it contains S2/S3 bytes.",
      "properties": {
        "s0": {
          "description": "Bytes classified S0.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "s1": {
          "description": "Bytes classified S1.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "s2": {
          "description": "Bytes classified S2.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "s3": {
          "description": "Bytes classified S3.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "s0",
        "s1",
        "s2",
        "s3"
      ],
      "type": "object"
    },
    "TierReason": {
      "additionalProperties": false,
      "description": "Why a candidate got (at least) a given tier. One per rubric row that fired (PRD §8.3); the\ncandidate's tier is the most protective of these.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ReasonCode",
          "description": "Stable machine-readable code."
        },
        "message": {
          "description": "Short human explanation shown in the preview.",
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/Tier",
          "description": "The minimum tier this reason imposes."
        }
      },
      "required": [
        "tier",
        "code",
        "message"
      ],
      "type": "object"
    },
    "Totals": {
      "additionalProperties": false,
      "description": "Byte totals over a set of candidates, split by tier (PHY-01: every size is labeled).\n\nLinked worktrees are totalled separately (`worktrees`), since their bytes include the\nartifacts inside them.",
      "properties": {
        "allocated": {
          "$ref": "#/$defs/TierBreakdown",
          "description": "Allocated bytes per tier."
        },
        "count": {
          "$ref": "#/$defs/TierBreakdown",
          "description": "Number of candidates per tier (artifacts and caches)."
        },
        "logical": {
          "$ref": "#/$defs/TierBreakdown",
          "description": "Logical bytes per tier."
        },
        "reclaimable": {
          "$ref": "#/$defs/TierBreakdown",
          "description": "Estimated reclaimable bytes per tier."
        },
        "worktrees": {
          "$ref": "#/$defs/WorktreeTotals",
          "description": "Worktree candidates (counted apart from artifacts)."
        }
      },
      "required": [
        "count",
        "logical",
        "allocated",
        "reclaimable",
        "worktrees"
      ],
      "type": "object"
    },
    "WorktreeTotals": {
      "additionalProperties": false,
      "description": "Totals of worktree candidates.",
      "properties": {
        "allocated": {
          "$ref": "#/$defs/TierBreakdown",
          "description": "Allocated bytes per tier."
        },
        "count": {
          "$ref": "#/$defs/TierBreakdown",
          "description": "Number of worktree candidates per tier."
        },
        "reclaimable": {
          "$ref": "#/$defs/TierBreakdown",
          "description": "Estimated reclaimable bytes per tier."
        }
      },
      "required": [
        "count",
        "allocated",
        "reclaimable"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A JSON document: schema identifier, scull version and the payload.",
  "properties": {
    "data": {
      "$ref": "#/$defs/CachesDocument",
      "description": "The payload."
    },
    "schema": {
      "const": "scull/caches@1",
      "description": "Payload schema, `scull/<name>@<major>`.",
      "pattern": "^scull/[a-z][a-z0-9-]*@[1-9][0-9]*$",
      "type": "string"
    },
    "version": {
      "description": "The scull version that produced this document.",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "version",
    "data"
  ],
  "title": "scull/caches@1",
  "type": "object"
}
