{
  "$defs": {
    "HistoryRead": {
      "description": "Whether the history database answered.",
      "oneOf": [
        {
          "const": "ok",
          "description": "The database answered (the series may still be empty).",
          "type": "string"
        },
        {
          "const": "no_database",
          "description": "No database yet (nothing was ever recorded, or history is off).",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "The database can't be read right now (`detail` says why).",
          "type": "string"
        }
      ]
    },
    "VolumeSampleView": {
      "additionalProperties": false,
      "description": "One volume's latest free-space sample from history.",
      "properties": {
        "free_bytes": {
          "description": "Bytes available to the user.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sampled_at": {
          "description": "When it was sampled (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "total_bytes": {
          "description": "Volume size in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "volume_id": {
          "description": "Volume identifier (mount point or volume GUID path).",
          "type": "string"
        }
      },
      "required": [
        "volume_id",
        "total_bytes",
        "free_bytes",
        "sampled_at"
      ],
      "type": "object"
    }
  },
  "$id": "scull-desktop/free-space-history.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`free_space_history`: one volume's free-space samples (INS-01), oldest first.",
  "properties": {
    "detail": {
      "description": "Why it didn't, when it didn't.",
      "type": [
        "string",
        "null"
      ]
    },
    "samples": {
      "description": "Samples at or after `since`, oldest first.",
      "items": {
        "$ref": "#/$defs/VolumeSampleView"
      },
      "type": "array"
    },
    "since": {
      "description": "Start of the window (Unix seconds).",
      "format": "int64",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/HistoryRead",
      "description": "Whether the database answered."
    },
    "volume_id": {
      "description": "The volume the samples belong to (`None` when nothing was ever sampled).",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "state",
    "since",
    "samples"
  ],
  "title": "FreeSpaceHistory",
  "type": "object"
}
