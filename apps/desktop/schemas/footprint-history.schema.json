{
  "$defs": {
    "FootprintSampleView": {
      "additionalProperties": false,
      "description": "scull's own disk use at one moment (DATA-05).",
      "properties": {
        "at": {
          "description": "When it was measured (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "backup_bytes": {
          "description": "Migration backups.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "damaged_bytes": {
          "description": "Damaged databases set aside.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "database_bytes": {
          "description": "The database file.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total_bytes": {
          "description": "Sum of the parts.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "wal_bytes": {
          "description": "The `-wal` and `-shm` files.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "at",
        "database_bytes",
        "wal_bytes",
        "backup_bytes",
        "damaged_bytes",
        "total_bytes"
      ],
      "type": "object"
    },
    "HistoryRead": {
      "description": "Whether the history database answered.",
      "oneOf": [
        {
          "const": "ok",
          "description": "The database answered (the series may still be empty).",
          "type": "string"
        },
        {
          "const": "no_database",
          "description": "No database yet (nothing was ever recorded, or history is off).",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "The database can't be read right now (`detail` says why).",
          "type": "string"
        }
      ]
    }
  },
  "$id": "scull-desktop/footprint-history.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`footprint_history`: scull's own footprint over time (\"What scull knows\").",
  "properties": {
    "detail": {
      "description": "Why it didn't, when it didn't.",
      "type": [
        "string",
        "null"
      ]
    },
    "raw_retention_days": {
      "description": "Raw free-space samples are kept this many days, then downsampled (INS-02).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "samples": {
      "description": "Samples at or after `since`, oldest first.",
      "items": {
        "$ref": "#/$defs/FootprintSampleView"
      },
      "type": "array"
    },
    "since": {
      "description": "Start of the window (Unix seconds).",
      "format": "int64",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/HistoryRead",
      "description": "Whether the database answered."
    }
  },
  "required": [
    "state",
    "since",
    "samples",
    "raw_retention_days"
  ],
  "title": "FootprintHistory",
  "type": "object"
}
