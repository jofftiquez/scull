{
  "$defs": {
    "Drive": {
      "additionalProperties": false,
      "description": "One volume in the drives widget. Unknown sizes are `null`, never 0.",
      "properties": {
        "free_bytes": {
          "description": "Bytes available to the current user, when known.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "holds_home": {
          "description": "The volume holding the user's home folder (listed first).",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/DriveKind",
          "description": "What kind of storage it is."
        },
        "label": {
          "description": "Short display name.",
          "type": "string"
        },
        "mount_point": {
          "description": "Where it is mounted (`/`, `/Volumes/Dev SSD`, `C:\\`).",
          "type": "string"
        },
        "scan_policy": {
          "$ref": "#/$defs/ScanPolicy",
          "description": "Whether scull scans it."
        },
        "total_bytes": {
          "description": "Size in bytes, when known.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "mount_point",
        "label",
        "kind",
        "scan_policy",
        "holds_home"
      ],
      "type": "object"
    },
    "DriveKind": {
      "description": "What kind of storage a volume is (mirrors [`VolumeKind`]).",
      "oneOf": [
        {
          "const": "local",
          "description": "Internal or fixed disk.",
          "type": "string"
        },
        {
          "const": "removable",
          "description": "Removable or external media.",
          "type": "string"
        },
        {
          "const": "network",
          "description": "Network filesystem.",
          "type": "string"
        },
        {
          "const": "virtual",
          "description": "Pseudo or virtual filesystem.",
          "type": "string"
        },
        {
          "const": "backup",
          "description": "Backup volume (never scanned, D-22).",
          "type": "string"
        }
      ]
    },
    "ScanPolicy": {
      "description": "Whether scull scans a volume (D-22).",
      "oneOf": [
        {
          "const": "scan",
          "description": "Scanned when connected.",
          "type": "string"
        },
        {
          "const": "off_by_default",
          "description": "Only on request (network and virtual volumes).",
          "type": "string"
        },
        {
          "const": "never",
          "description": "Never (backup volumes).",
          "type": "string"
        }
      ]
    }
  },
  "$id": "scull-desktop/drives.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "$ref": "#/$defs/Drive"
  },
  "title": "Drives",
  "type": "array"
}
