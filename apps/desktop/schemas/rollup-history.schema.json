{
  "$defs": {
    "Category": {
      "description": "Broad category of a candidate, used for grouping in the CLI, charts and Quick Clean.",
      "oneOf": [
        {
          "const": "project_artifact",
          "description": "Build output or dependencies inside a project (`target/`, `node_modules`, `.next`, …).",
          "type": "string"
        },
        {
          "const": "package_cache",
          "description": "Global package-manager cache (Quick Clean, QC-01).",
          "type": "string"
        },
        {
          "const": "worktree",
          "description": "A Git worktree, whole or stale registration.",
          "type": "string"
        },
        {
          "const": "ml_cache",
          "description": "ML/AI model or dataset cache.",
          "type": "string"
        },
        {
          "const": "container",
          "description": "Docker / container data.",
          "type": "string"
        },
        {
          "const": "large_file",
          "description": "Large file surfaced for inspection only.",
          "type": "string"
        },
        {
          "const": "scull_data",
          "description": "scull's own data (database, logs, quarantine; DATA-05).",
          "type": "string"
        },
        {
          "const": "other",
          "description": "Anything else.",
          "type": "string"
        }
      ]
    },
    "CategorySeries": {
      "additionalProperties": false,
      "description": "One category's bytes per usable scan.",
      "properties": {
        "category": {
          "$ref": "#/$defs/Category",
          "description": "The category."
        },
        "points": {
          "description": "One point per usable scan in the window (zero when the scan found none), oldest first.",
          "items": {
            "$ref": "#/$defs/RollupPointView"
          },
          "type": "array"
        }
      },
      "required": [
        "category",
        "points"
      ],
      "type": "object"
    },
    "HistoryRead": {
      "description": "Whether the history database answered.",
      "oneOf": [
        {
          "const": "ok",
          "description": "The database answered (the series may still be empty).",
          "type": "string"
        },
        {
          "const": "no_database",
          "description": "No database yet (nothing was ever recorded, or history is off).",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "The database can't be read right now (`detail` says why).",
          "type": "string"
        }
      ]
    },
    "RollupPointView": {
      "additionalProperties": false,
      "description": "One point of a category series: the category's bytes in one scan.",
      "properties": {
        "allocated_bytes": {
          "description": "Allocated (on-disk) bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "at": {
          "description": "Scan finish time (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "items": {
          "description": "Candidates.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "logical_bytes": {
          "description": "Logical bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "reclaimable_bytes": {
          "description": "Reclaimable bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "scan_id": {
          "description": "The scan.",
          "type": "string"
        }
      },
      "required": [
        "at",
        "scan_id",
        "items",
        "logical_bytes",
        "allocated_bytes",
        "reclaimable_bytes"
      ],
      "type": "object"
    }
  },
  "$id": "scull-desktop/rollup-history.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`rollup_history`: bytes per category per usable scan (INS-02 growth, the mix chart).",
  "properties": {
    "detail": {
      "description": "Why it didn't, when it didn't.",
      "type": [
        "string",
        "null"
      ]
    },
    "series": {
      "description": "Categories with at least one non-zero point, in [`CATEGORIES`] order.",
      "items": {
        "$ref": "#/$defs/CategorySeries"
      },
      "type": "array"
    },
    "since": {
      "description": "Start of the window (Unix seconds).",
      "format": "int64",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/HistoryRead",
      "description": "Whether the database answered."
    }
  },
  "required": [
    "state",
    "since",
    "series"
  ],
  "title": "RollupHistory",
  "type": "object"
}
