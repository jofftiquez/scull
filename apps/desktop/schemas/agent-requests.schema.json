{
  "$defs": {
    "AgentRequest": {
      "additionalProperties": false,
      "description": "An agent plan waiting for the human, for the pending-requests notice.",
      "properties": {
        "content_hash": {
          "description": "Content hash the approval will be bound to.",
          "type": "string"
        },
        "created_at": {
          "description": "When the agent prepared it (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "expires_at": {
          "description": "When it expires unapproved (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "item_count": {
          "description": "Items in the plan.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "plan_id": {
          "description": "Plan ID (open it with `open_approval_request`).",
          "type": "string"
        },
        "reclaimable_bytes": {
          "description": "Bytes the plan predicts it frees.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "plan_id",
        "content_hash",
        "created_at",
        "expires_at",
        "item_count",
        "reclaimable_bytes"
      ],
      "type": "object"
    }
  },
  "$id": "scull-desktop/agent-requests.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Agent plans waiting for the human, newest first.",
  "properties": {
    "requests": {
      "description": "The requests (empty without a database or machine ID).",
      "items": {
        "$ref": "#/$defs/AgentRequest"
      },
      "type": "array"
    }
  },
  "required": [
    "requests"
  ],
  "title": "AgentRequests",
  "type": "object"
}
