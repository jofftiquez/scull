{
  "$defs": {
    "AuditLine": {
      "additionalProperties": false,
      "description": "One line of an operation's audit log, rendered from its chain rows.",
      "properties": {
        "at": {
          "description": "When (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/AuditLineKind",
          "description": "Line kind."
        },
        "text": {
          "description": "Text, e.g. `plan 7f3a·c21e approved · desktop`.",
          "type": "string"
        }
      },
      "required": [
        "at",
        "kind",
        "text"
      ],
      "type": "object"
    },
    "AuditLineKind": {
      "description": "Kind of an audit log line, for its colour.",
      "oneOf": [
        {
          "const": "approval",
          "description": "Plan approval (who, how).",
          "type": "string"
        },
        {
          "const": "check",
          "description": "Re-checks and tool resolution.",
          "type": "string"
        },
        {
          "const": "action",
          "description": "Something was done (deleted, quarantined, tool run, restored).",
          "type": "string"
        },
        {
          "const": "measured",
          "description": "Measured free-space delta.",
          "type": "string"
        },
        {
          "const": "warning",
          "description": "A warning (e.g. a local snapshot held space).",
          "type": "string"
        }
      ]
    },
    "ChainCheck": {
      "additionalProperties": false,
      "description": "Result of verifying an operation's hash chain.",
      "properties": {
        "intact": {
          "description": "No tampering or damage found.",
          "type": "boolean"
        },
        "problems": {
          "description": "What was wrong, when something was.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rows": {
          "description": "Chain rows checked.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "intact",
        "rows",
        "problems"
      ],
      "type": "object"
    },
    "HistoryItem": {
      "additionalProperties": false,
      "description": "One item of an operation.",
      "properties": {
        "action": {
          "description": "Planned action (`delete`, `quarantine`, `trash`, `tool`, `worktree_remove`).",
          "type": "string"
        },
        "freed_bytes": {
          "description": "Bytes freed (deleted or tool-cleaned).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "item_id": {
          "description": "The plan item's identifier.",
          "type": "string"
        },
        "label": {
          "description": "Short label when the path alone doesn't say it (e.g. `pnpm store (pruned)`).",
          "type": [
            "string",
            "null"
          ]
        },
        "moved_bytes": {
          "description": "Bytes moved (quarantine or Trash).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/ItemOutcome",
          "description": "What happened."
        },
        "path": {
          "description": "The path the plan named (or the tool's cache for Quick Clean).",
          "type": "string"
        },
        "predicted_bytes": {
          "description": "Bytes the plan predicted.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "reason": {
          "description": "Reason code for failed, refused, skipped or partial outcomes.",
          "type": [
            "string",
            "null"
          ]
        },
        "restorable_until": {
          "description": "For quarantined items: when the quarantine retention ends (Unix seconds).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "restored_to": {
          "description": "For restored items: where it went back to (the original path, or a\n`<name>.scull-restored-<n>` sibling when the original was taken; never overwritten).",
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tier"
            },
            {
              "type": "null"
            }
          ],
          "description": "Safety tier at planning time."
        }
      },
      "required": [
        "item_id",
        "path",
        "action",
        "outcome",
        "predicted_bytes"
      ],
      "type": "object"
    },
    "HistoryOperation": {
      "additionalProperties": false,
      "description": "One recorded operation.",
      "properties": {
        "agent": {
          "description": "The agent that prepared the plan (agent operations).",
          "type": [
            "string",
            "null"
          ]
        },
        "approver": {
          "description": "Who approved it (`you`, or the agent that prepared it and `you`).",
          "type": "string"
        },
        "chain": {
          "$ref": "#/$defs/ChainCheck",
          "description": "Hash-chain verification."
        },
        "delta_explanations": {
          "description": "Why the measured delta differs from the prediction (codes, e.g. `local_snapshot`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "finished_at": {
          "description": "Finish (Unix seconds), `None` while running.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "items": {
          "description": "Items, in plan order.",
          "items": {
            "$ref": "#/$defs/HistoryItem"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/OperationKind",
          "description": "What it did."
        },
        "log": {
          "description": "Audit log, in chain order.",
          "items": {
            "$ref": "#/$defs/AuditLine"
          },
          "type": "array"
        },
        "measured_delta_bytes": {
          "description": "Measured change in free space (bytes; may be negative or missing).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "method": {
          "description": "Where it was approved (`desktop`, `cli`, `desktop_dialog`).",
          "type": "string"
        },
        "operation_id": {
          "description": "Operation identifier.",
          "type": "string"
        },
        "origin": {
          "description": "Where it was started from (`Cleanup Review`, `Overview`, ...), when known.",
          "type": [
            "string",
            "null"
          ]
        },
        "plan_id": {
          "description": "The approved plan it executed.",
          "type": "string"
        },
        "predicted_bytes": {
          "description": "Bytes the plan predicted.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "started_at": {
          "description": "Start (Unix seconds).",
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/OperationStatus",
          "description": "How it ended."
        },
        "summary": {
          "description": "The plan's one-line description, when it has one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "operation_id",
        "plan_id",
        "kind",
        "approver",
        "method",
        "started_at",
        "status",
        "predicted_bytes",
        "delta_explanations",
        "items",
        "log",
        "chain"
      ],
      "type": "object"
    },
    "HistoryReadState": {
      "description": "Whether there is history to show.",
      "oneOf": [
        {
          "const": "ok",
          "description": "The database was read.",
          "type": "string"
        },
        {
          "const": "no_database",
          "description": "No database yet (nothing was ever recorded).",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "The database can't be read by this build (newer or older schema, damaged, foreign);\n`detail` says why. It was not touched.",
          "type": "string"
        }
      ]
    },
    "ItemOutcome": {
      "description": "The outcome of one plan item.",
      "oneOf": [
        {
          "const": "removed",
          "description": "Deleted by the Executor.",
          "type": "string"
        },
        {
          "const": "quarantined",
          "description": "Moved to scull's same-volume quarantine; restorable until `restorable_until`.",
          "type": "string"
        },
        {
          "const": "moved_to_trash",
          "description": "Moved to the system Trash / Recycle Bin.",
          "type": "string"
        },
        {
          "const": "tool_run",
          "description": "Cleaned by the package manager's own command (Quick Clean).",
          "type": "string"
        },
        {
          "const": "partial",
          "description": "Partly removed (some entries were kept or failed).",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Failed; nothing or part of it was removed (`reason`).",
          "type": "string"
        },
        {
          "const": "refused",
          "description": "Refused by a safety re-check at execution time (`reason`).",
          "type": "string"
        },
        {
          "const": "skipped",
          "description": "Skipped (changed since the plan, or the operation was cancelled).",
          "type": "string"
        },
        {
          "const": "restored",
          "description": "Was quarantined, then restored (`restored_to`).",
          "type": "string"
        },
        {
          "const": "purged",
          "description": "Was quarantined, then purged when the retention ended.",
          "type": "string"
        }
      ]
    },
    "OperationKind": {
      "description": "What an operation did, for the timeline's icon and wording.",
      "oneOf": [
        {
          "const": "cleanup",
          "description": "A reviewed cleanup plan (Cleanup Review, Projects).",
          "type": "string"
        },
        {
          "const": "quick_clean",
          "description": "Quick Clean: package-manager tools run on their caches.",
          "type": "string"
        },
        {
          "const": "worktrees",
          "description": "`git worktree remove` of whole worktrees (branches kept).",
          "type": "string"
        },
        {
          "const": "agent",
          "description": "A plan an AI agent prepared through MCP and a human approved outside the chat.",
          "type": "string"
        }
      ]
    },
    "OperationStatus": {
      "description": "How an operation ended.",
      "oneOf": [
        {
          "const": "completed",
          "description": "Every item has an outcome and none failed.",
          "type": "string"
        },
        {
          "const": "completed_with_errors",
          "description": "Finished, but some items failed or were refused.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Nothing was done.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "The user stopped it; the remaining items were skipped.",
          "type": "string"
        },
        {
          "const": "interrupted",
          "description": "scull stopped mid-way (crash, power loss); recovered from the journal.",
          "type": "string"
        },
        {
          "const": "running",
          "description": "Still running (no `finished` row yet).",
          "type": "string"
        }
      ]
    },
    "Tier": {
      "description": "How much risk removing an item carries.\n\nThe ordering is by **protectiveness**: `S0 < S1 < S2 < S3`. Combining evidence always takes\nthe maximum (the most protective tier), and a tier may only ever move *up* this order after a\nscan (invariant I-8: tiers never decrease on revalidation).",
      "oneOf": [
        {
          "const": "S0",
          "description": "Regenerable: a verified generated artifact, reproducible from tracked inputs.\nPreselected for review, but never executed without confirmation.",
          "type": "string"
        },
        {
          "const": "S1",
          "description": "Costly to recreate: reproducible, but needs a significant download or build. Opt-in.",
          "type": "string"
        },
        {
          "const": "S2",
          "description": "Uncertain: ownership, activity or reproducibility is unclear. Never preselected.",
          "type": "string"
        },
        {
          "const": "S3",
          "description": "Protected: possibly unique data, in active use, or explicitly protected. Never acted on.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "scull-desktop/history.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`history`: every recorded operation, newest first.",
  "properties": {
    "audit_api": {
      "description": "Whether this build of the core can read operations and their audit chain (always\n`true` since the Phase 2 audit API; `false` only from a build without it, whose list\nis empty by construction).",
      "type": "boolean"
    },
    "detail": {
      "description": "Why it couldn't be, when it couldn't.",
      "type": [
        "string",
        "null"
      ]
    },
    "now": {
      "description": "When this report was produced (Unix seconds).",
      "format": "int64",
      "type": "integer"
    },
    "operations": {
      "description": "Operations, newest first.",
      "items": {
        "$ref": "#/$defs/HistoryOperation"
      },
      "type": "array"
    },
    "state": {
      "$ref": "#/$defs/HistoryReadState",
      "description": "Whether the database was read."
    }
  },
  "required": [
    "state",
    "now",
    "audit_api",
    "operations"
  ],
  "title": "HistoryView",
  "type": "object"
}
