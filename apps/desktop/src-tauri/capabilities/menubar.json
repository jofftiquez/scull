{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "menubar",
  "description": "The menu bar widget (menubar): scull's own read and window commands and core events, but none of the commands that approve, deny or revoke an AI agent's plan (main window only, P4-MCP-02). No filesystem, shell, process or HTTP plugin (SAFE-10).",
  "windows": [
    "menubar"
  ],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-drives",
    "allow-scan",
    "allow-caches",
    "allow-cancel-operation",
    "allow-projects",
    "allow-worktrees",
    "allow-status",
    "allow-capabilities",
    "allow-history",
    "allow-settings",
    "allow-free-space-history",
    "allow-rollup-history",
    "allow-regrowth",
    "allow-footprint-history",
    "allow-forecasts",
    "allow-weekly-digest",
    "allow-monitor-status",
    "allow-configure-monitor",
    "allow-pause-monitor",
    "allow-send-digest-now",
    "allow-open-main-window",
    "allow-hide-menu-bar"
  ]
}
