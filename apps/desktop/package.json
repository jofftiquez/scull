{
  "name": "@scull/desktop",
  "private": true,
  "version": "0.0.0",
  "description": "scull desktop app (Tauri 2 + Vue 3).",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && vue-tsc --noEmit && node scripts/gen-theme.mjs --check && node scripts/gen-types.mjs --check",
    "test": "vitest run",
    "tokens": "node scripts/gen-theme.mjs",
    "types": "node scripts/gen-types.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.12",
    "@types/d3-shape": "3.2.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "ajv": "8.20.0",
    "d3-hierarchy": "3.1.2",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "echarts": "6.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14"
  }
