{
  "name": "@scull/desktop",
  "private": true,
  "version": "0.0.0",
  "description": "scull desktop app (Tauri 2 + React).",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && tsc --noEmit && node scripts/gen-theme.mjs --check && node scripts/gen-types.mjs --check",
    "test": "vitest run",
    "tokens": "node scripts/gen-theme.mjs",
    "types": "node scripts/gen-types.mjs",
    "tauri": "tauri",
    "e2e": "e2e/run.sh"
  },
  "dependencies": {
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
